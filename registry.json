{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "cd-ui",
  "homepage": "http://localhost:3001",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Tema cd/ui",
      "description": "Tokens de cor, raio e curvas de animação do cd/ui (creme/grafite + amarelo).",
      "cssVars": {
        "theme": {
          "color-brand": "var(--brand)",
          "color-brand-foreground": "var(--brand-foreground)",
          "color-brand-contrast": "var(--brand-contrast)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
          "ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)"
        },
        "light": {
          "background": "#f6f4ee",
          "foreground": "#262626",
          "card": "#fbfaf6",
          "card-foreground": "#262626",
          "popover": "#fbfaf6",
          "popover-foreground": "#262626",
          "muted": "rgb(0 0 0 / 0.04)",
          "muted-foreground": "#686868",
          "accent": "rgb(0 0 0 / 0.04)",
          "accent-foreground": "#262626",
          "border": "rgb(0 0 0 / 0.08)",
          "input": "rgb(0 0 0 / 0.12)",
          "ring": "#e0b320",
          "destructive": "#dc2626",
          "destructive-foreground": "#b91c1c",
          "brand": "#ffd23f",
          "brand-foreground": "#7a5c00",
          "brand-contrast": "#1c1c1c",
          "radius": "0.625rem"
        },
        "dark": {
          "background": "#1c1c1c",
          "foreground": "#f5f5f5",
          "card": "#222220",
          "card-foreground": "#f5f5f5",
          "popover": "#222220",
          "popover-foreground": "#f5f5f5",
          "muted": "rgb(255 255 255 / 0.04)",
          "muted-foreground": "#8a8a8a",
          "accent": "rgb(255 255 255 / 0.06)",
          "accent-foreground": "#f5f5f5",
          "border": "rgb(255 255 255 / 0.08)",
          "input": "rgb(255 255 255 / 0.12)",
          "ring": "#ffd23f",
          "destructive": "#dc2626",
          "destructive-foreground": "#f87171",
          "brand-foreground": "#ffd23f"
        }
      }
    },
